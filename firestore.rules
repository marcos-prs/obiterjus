rules_version = '2';

// Cada usuário só enxerga o próprio documento e tudo que pende dele.
// Sessão anônima é recusada: o uid anônimo é efêmero (some no reinstall) e
// deixaria dado órfão sem titular que possa pedir exclusão.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId}/{document=**} {
      allow read, write: if isDono(userId);
    }

    function isDono(userId) {
      return request.auth != null
          && request.auth.uid == userId
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
  }
}
